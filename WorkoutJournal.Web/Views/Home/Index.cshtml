@{
    ViewData["Title"] = "Home Page";
}

@if (User?.Identity?.IsAuthenticated ?? false)
{
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">Choose your workout</h1>
        <p class="lead">Pick a day and log your exercises.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <a asp-controller="Workouts" asp-action="Create" asp-route-category="ChestAndBiceps" class="text-decoration-none text-dark">
                <div class="card h-100 shadow-sm">
                    <img src="~/images/chest.jpg" class="card-img-top" alt="Chest and biceps" />
                    <div class="card-body text-center">
                        <h5 class="card-title mb-0">Chest + Biceps</h5>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="Workouts" asp-action="Create" asp-route-category="BackAndTriceps" class="text-decoration-none text-dark">
                <div class="card h-100 shadow-sm">
                    <img src="~/images/back.jpg" class="card-img-top" alt="Back and triceps" />
                    <div class="card-body text-center">
                        <h5 class="card-title mb-0">Back + Triceps</h5>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="Workouts" asp-action="Create" asp-route-category="Legs" class="text-decoration-none text-dark">
                <div class="card h-100 shadow-sm">
                    <img src="~/images/legs.jpg" class="card-img-top" alt="Legs" />
                    <div class="card-body text-center">
                        <h5 class="card-title mb-0">Legs</h5>
                    </div>
                </div>
            </a>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <h1 class="display-4 fw-bold">Welcome to WorkoutJournal</h1>
        <p class="lead">Log in or register to start tracking your workouts.</p>
        <a class="btn btn-warning" asp-area="Identity" asp-page="/Account/Login">Login</a>
        <a class="btn btn-outline-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </div>
}