@{
    ViewData["Title"] = "Home Page";
}

@if (User?.Identity?.IsAuthenticated ?? false)
{
    <div class="text-center py-5">
        <h1 class="display-5 fw-bold">Your training log</h1>
        <p class="lead">Plan a workout, add exercises and track your progress.</p>
        <a asp-controller="Workouts" asp-action="Create" class="btn btn-warning btn-lg">New workout</a>
        <a asp-controller="Workouts" asp-action="Index" class="btn btn-outline-dark btn-lg">My workouts</a>
    </div>
}
else
{
    <div class="text-center py-5">
        <h1 class="display-4 fw-bold">Welcome to WorkoutJournal</h1>
        <p class="lead">Log in or register to start tracking your workouts.</p>
        <a class="btn btn-warning" asp-area="Identity" asp-page="/Account/Login">Login</a>
        <a class="btn btn-outline-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </div>
}