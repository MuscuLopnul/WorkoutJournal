@model IEnumerable<WorkoutIndexViewModel>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h2>
    My Workouts
</h2>
<p>
    Track your workouts and keep improving.
</p>
@foreach (var workout in Model)
{
    <p>@workout.Name - @workout.WorkoutStatus</p>
    <a asp-controller="Workouts"
       asp-action="Edit"
       asp-route-id="@workout.Id"
       class="btn btn-primary">
        Edit Workout
    </a>
    <br />
}
<a asp-controller="Workouts"
   asp-action="Create"
   class="btn btn-primary">
    Create Workout
</a>