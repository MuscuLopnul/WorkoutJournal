@model IEnumerable<WorkoutIndexViewModel>

@{
    ViewData["Title"] = "My Workouts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">My Workouts</h2>
    <a asp-action="Create" class="btn btn-primary">New workout</a>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <ul class="list-group list-group-flush">
        @if (!Model.Any())
        {
            <li class="list-group-item text-center text-muted py-4">
                No workouts yet. Create your first one!
            </li>
        }

        @foreach (var workout in Model)
        {
            var badgeClass = "bg-secondary";
            if (workout.WorkoutStatus == "Completed")
            {
                badgeClass = "bg-success";
            }
            else if (workout.WorkoutStatus == "PartiallyCompleted")
            {
                badgeClass = "bg-warning text-dark";
            }
            else if (workout.WorkoutStatus == "Skipped")
            {
                badgeClass = "bg-danger";
            }

            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div>
                    <div class="fw-bold">@workout.Name</div>
                    <div class="text-muted small">@workout.Date.ToString("dd.MM.yyyy")</div>
                </div>
                <div>
                    <span class="badge @badgeClass me-3">@workout.WorkoutStatus</span>
                    <a asp-action="Edit" asp-route-id="@workout.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                </div>
            </li>
        }
    </ul>
</div>